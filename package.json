{
  "name": "qlb",
  "version": "0.0.0",
  "private": true,
  "description": "Local quota visibility and account selection across AI coding providers",
  "license": "MIT",
  "repository": "git+https://github.com/sanketvp/qlb.git",
  "keywords": [
    "ai",
    "cli",
    "quota",
    "load-balancer",
    "anthropic",
    "codex"
  ],
  "type": "commonjs",
  "bin": {
    "qlb": "./dist/cli.js"
  },
  "scripts": {
    "build": "node scripts/clean-registry-output.cjs && tsc",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "export QLB_TEST_MODE=1 QLB_HOME=\"$(mktemp -d)\"; node scripts/clean-registry-output.cjs dist-test/src && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "typecheck:pi": "tsc && node scripts/typecheck-pi.js",
    "build:helper": "node scripts/build-helper.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": ["extensions/qlb-pi/index.ts"]
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
