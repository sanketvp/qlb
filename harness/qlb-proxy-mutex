#!/usr/bin/python3
"""Exclusive flock then execvp the critical section, inheriting the lock fd.

Usage: qlb-proxy-mutex LOCK -- cmd [args...]

The lock fd is exposed to the child as QLB_PROXY_LOCK_FD and marked inheritable
so the critical section holds the flock across execvp. The child must launch any
long-running process (the loopback proxy) with that fd closed / CLOEXEC and
close its own copy after startup + ownership publication, or later wrappers
block for the proxy's lifetime.
"""
from __future__ import annotations

import fcntl
import os
import signal
import sys
import time


def main() -> None:
    if len(sys.argv) < 4 or sys.argv[2] != "--":
        sys.stderr.write("usage: qlb-proxy-mutex LOCK -- cmd [args...]\n")
        sys.exit(2)
    lock = sys.argv[1]
    argv = sys.argv[3:]
    # Shares the wrapper's process group: a terminal Ctrl-C / hangup while
    # waiting for the lock must not kill setup or final cleanup. Inherited by the
    # exec'd command; long-running children restore their own handling.
    signal.signal(signal.SIGINT, signal.SIG_IGN)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    timeout_s = float(os.environ.get("QLB_PROXY_LOCK_TIMEOUT_S") or "60")
    fd = os.open(lock, os.O_CREAT | os.O_RDWR, 0o600)
    deadline = time.monotonic() + timeout_s
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            break
        except BlockingIOError:
            if time.monotonic() >= deadline:
                sys.stderr.write(f"qlb-proxy-mutex: timed out after {timeout_s:g}s waiting for {lock}\n")
                sys.exit(75)
            time.sleep(0.05)
    os.set_inheritable(fd, True)
    os.environ["QLB_PROXY_LOCK_FD"] = str(fd)
    os.execvp(argv[0], argv)


if __name__ == "__main__":
    main()
