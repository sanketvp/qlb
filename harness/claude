#!/usr/bin/python3
"""Supervising Claude Code wrapper: shared loopback proxy on 127.0.0.1:47391.

Intercepted invocations hold the proxy mutex only for reap/lease/attach-or-start,
launch the persistent proxy with the lock fd closed, then spawn native Claude.
Passthrough subcommands exec the native binary with no QLB env and no lease.

Do not PATH-install this file until live-change approvals land.
"""
from __future__ import annotations

import json
import os
import signal
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from typing import Any, Optional

PASSTHROUGH = {
    "plugin",
    "mcp",
    "update",
    "doctor",
    "auth",
    "install",
    "uninstall",
    "serve",
    "--version",
    "-v",
    "-h",
    "--help",
    "help",
}

DEFAULT_PORT = 47391


def qlb_home() -> str:
    return os.environ.get("QLB_HOME") or os.path.join(os.path.expanduser("~"), ".qlb")


def native_claude() -> str:
    return os.environ.get("QLB_CLAUDE_NATIVE") or os.path.join(
        os.path.expanduser("~"), ".local", "bin", "claude"
    )


def qlb_argv() -> list[str]:
    binary = os.environ.get("QLB_BIN") or "qlb"
    if binary.endswith(".js"):
        node = os.environ.get("QLB_NODE") or "node"
        return [node, binary]
    return [binary]


def process_lstart(pid: int) -> str:
    try:
        out = subprocess.check_output(
            ["ps", "-p", str(pid), "-o", "lstart="],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        return out.strip()
    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
        return ""


def process_command(pid: int) -> str:
    try:
        out = subprocess.check_output(
            ["ps", "-p", str(pid), "-o", "command="],
            text=True,
            stderr=subprocess.DEVNULL,
        )
        return out.strip()
    except (subprocess.CalledProcessError, FileNotFoundError, OSError):
        return ""


def identity_live(pid: int, stored: str) -> bool:
    try:
        os.kill(int(pid), 0)
    except (OSError, ValueError):
        return False
    if not stored:
        return False
    return process_lstart(int(pid)) == stored


def atomic_write(path: str, contents: str, mode: int = 0o600) -> None:
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, mode=0o700, exist_ok=True)
    tmp = f"{path}.tmp.{os.getpid()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    try:
        os.write(fd, contents.encode("utf8"))
    finally:
        os.close(fd)
    os.replace(tmp, path)
    try:
        os.chmod(path, mode)
    except OSError:
        pass


def read_json(path: str) -> Optional[dict[str, Any]]:
    try:
        with open(path, "r", encoding="utf8") as fh:
            data = json.load(fh)
        if isinstance(data, dict):
            return data
    except (OSError, json.JSONDecodeError):
        return None
    return None


def port_listening(port: int, host: str = "127.0.0.1") -> bool:
    import socket

    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    sock.settimeout(0.25)
    try:
        sock.connect((host, port))
        return True
    except OSError:
        return False
    finally:
        sock.close()


def health_ok(port: int, token: str) -> bool:
    req = urllib.request.Request(
        f"http://127.0.0.1:{port}/qlb/health",
        headers={"Authorization": f"Bearer {token}", "Host": f"127.0.0.1:{port}"},
        method="GET",
    )
    try:
        with urllib.request.urlopen(req, timeout=2) as resp:
            return 200 <= getattr(resp, "status", 200) < 300
    except (urllib.error.URLError, TimeoutError, OSError):
        return False


def lease_dir(home: str) -> str:
    path = os.path.join(home, "proxy-leases")
    os.makedirs(path, mode=0o700, exist_ok=True)
    return path


def lease_path(home: str, pid: int) -> str:
    return os.path.join(lease_dir(home), str(pid))


def reap_leases(home: str) -> bool:
    """Unlink identity-dead leases. Returns True if a pid-reuse reap happened."""
    reused = False
    directory = lease_dir(home)
    for name in os.listdir(directory):
        path = os.path.join(directory, name)
        row = read_json(path)
        if not row:
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        pid = row.get("pid")
        stored = row.get("lstart") or ""
        if not isinstance(pid, int):
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        try:
            os.kill(pid, 0)
            live_pid = True
        except OSError:
            live_pid = False
        if not live_pid:
            try:
                os.unlink(path)
            except OSError:
                pass
            continue
        if stored and process_lstart(pid) != stored:
            reused = True
            try:
                os.unlink(path)
            except OSError:
                pass
            print("PID_REUSE_REAP=1", flush=True)
    return reused


def live_leases(home: str) -> list[dict[str, Any]]:
    out: list[dict[str, Any]] = []
    directory = lease_dir(home)
    for name in os.listdir(directory):
        row = read_json(os.path.join(directory, name))
        if not row:
            continue
        pid = row.get("pid")
        stored = row.get("lstart") or ""
        if isinstance(pid, int) and identity_live(pid, stored if isinstance(stored, str) else ""):
            out.append(row)
    return out


def close_lock_fd() -> None:
    raw = os.environ.get("QLB_PROXY_LOCK_FD")
    if not raw:
        return
    try:
        fd = int(raw)
    except ValueError:
        return
    try:
        os.close(fd)
    except OSError:
        pass
    os.environ.pop("QLB_PROXY_LOCK_FD", None)


def wait_identity_dead(pid: int, stored: str, timeout_s: float) -> bool:
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        if not identity_live(pid, stored):
            return True
        time.sleep(0.05)
    return not identity_live(pid, stored)


def sigterm_proxy(info: dict[str, Any], info_path: str) -> bool:
    """Identity-guarded stop. Unlinks ownership metadata only once the proxy is gone.

    Returns False (metadata retained) if the proxy could not be confirmed dead.
    """
    pid = info.get("pid")
    stored = info.get("lstart") or ""
    stored = stored if isinstance(stored, str) else ""
    if not isinstance(pid, int):
        return True
    if not identity_live(pid, stored):
        return True
    cmd = process_command(pid)
    if "proxy" not in cmd:
        return True
    try:
        os.kill(pid, signal.SIGTERM)
    except OSError:
        pass
    dead = wait_identity_dead(pid, stored, 2.5)
    if not dead:
        # SIGTERM awaits server.close(); an in-flight request can hold it open.
        # Re-check the same identity immediately before escalating.
        if identity_live(pid, stored) and "proxy" in process_command(pid):
            print("PROXY_SIGKILL=1", flush=True)
            try:
                os.kill(pid, signal.SIGKILL)
            except OSError:
                pass
        dead = wait_identity_dead(pid, stored, 2.0)
    if not dead:
        sys.stderr.write(
            f"qlb wrapper: proxy pid {pid} still alive after SIGKILL; keeping {info_path}\n"
        )
        return False
    try:
        if os.path.exists(info_path):
            os.unlink(info_path)
    except OSError:
        pass
    return True


def wait_for_proxy_json(info_path: str, timeout_s: float = 10.0) -> Optional[dict[str, Any]]:
    deadline = time.time() + timeout_s
    while time.time() < deadline:
        info = read_json(info_path)
        if info and isinstance(info.get("token"), str) and info.get("token"):
            return info
        time.sleep(0.05)
    return None


def critical_section() -> int:
    home = qlb_home()
    port = int(os.environ.get("QLB_PROXY_PORT") or DEFAULT_PORT)
    info_path = os.environ.get("QLB_PROXY_INFO_PATH") or os.path.join(home, "proxy.json")
    wrapper_pid = int(os.environ["QLB_WRAPPER_PID"])
    wrapper_lstart = os.environ["QLB_WRAPPER_LSTART"]
    session = os.environ.get("QLB_SESSION") or str(uuid.uuid4())

    reap_leases(home)
    remaining = live_leases(home)
    info = read_json(info_path)
    if not remaining and info and info.get("startedBy") == "wrapper":
        pid = info.get("pid")
        stored = info.get("lstart") or ""
        if isinstance(pid, int) and identity_live(pid, stored if isinstance(stored, str) else ""):
            print("ORPHAN_CLEANUP=1", flush=True)
            if not sigterm_proxy(info, info_path):
                close_lock_fd()
                return 1
            info = None

    atomic_write(
        lease_path(home, wrapper_pid),
        json.dumps(
            {
                "pid": wrapper_pid,
                "lstart": wrapper_lstart,
                "session": session,
                "startedAt": int(time.time() * 1000),
            }
        ),
    )

    deadline = time.time() + 5.0
    while time.time() < deadline:
        info = read_json(info_path)
        if info:
            token = info.get("token")
            pid = info.get("pid")
            stored = info.get("lstart") or ""
            info_port = info.get("port")
            if (
                isinstance(token, str)
                and isinstance(pid, int)
                and identity_live(pid, stored if isinstance(stored, str) else "")
                and info_port == port
                and health_ok(port, token)
            ):
                close_lock_fd()
                return 0
        if port_listening(port) and not info:
            break
        time.sleep(0.05)

    if port_listening(port):
        print("ORPHAN_LISTEN=fail-closed", flush=True)
        close_lock_fd()
        return 1

    cmd = qlb_argv() + [
        "proxy",
        "--port",
        str(port),
        "--no-idle",
        "--info-path",
        info_path,
        "--started-by",
        "wrapper",
    ]
    db = os.environ.get("QLB_DB_PATH")
    if db:
        cmd.extend(["--db", db])
    child_env = os.environ.copy()
    child_env.pop("QLB_PROXY_LOCK_FD", None)
    subprocess.Popen(
        cmd,
        close_fds=True,
        start_new_session=True,
        env=child_env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )
    started = wait_for_proxy_json(info_path)
    if not started:
        close_lock_fd()
        return 1
    close_lock_fd()
    return 0


def passthrough(argv: list[str]) -> int:
    native = native_claude()
    os.execv(native, [native, *argv])
    return 127


def record_terminating_signal(home: str, pid: int, name: str) -> None:
    path = lease_path(home, pid)
    row = read_json(path)
    if not row or row.get("pid") != pid:
        return  # no lease yet (or not ours): never fabricate one
    row["terminatingSignal"] = name
    atomic_write(path, json.dumps(row))


def maybe_shutdown_proxy(home: str, info_path: str) -> bool:
    if live_leases(home):
        return True
    info = read_json(info_path)
    if not info or info.get("startedBy") != "wrapper":
        return True
    pid = info.get("pid")
    stored = info.get("lstart") or ""
    if not isinstance(pid, int) or not identity_live(pid, stored if isinstance(stored, str) else ""):
        return True
    return sigterm_proxy(info, info_path)


def final_shutdown() -> int:
    """Lease unlink + last-lease decision + identity-guarded SIGTERM, under the mutex."""
    home = qlb_home()
    info_path = os.environ.get("QLB_PROXY_INFO_PATH") or os.path.join(home, "proxy.json")
    wrapper_pid = int(os.environ["QLB_WRAPPER_PID"])
    try:
        os.unlink(lease_path(home, wrapper_pid))
    except OSError:
        pass
    ok = maybe_shutdown_proxy(home, info_path)
    close_lock_fd()
    return 0 if ok else 1


def intercepted(argv: list[str]) -> int:
    home = qlb_home()
    os.makedirs(home, mode=0o700, exist_ok=True)
    lock = os.path.join(home, "proxy.lock")
    info_path = os.environ.get("QLB_PROXY_INFO_PATH") or os.path.join(home, "proxy.json")
    port = int(os.environ.get("QLB_PROXY_PORT") or DEFAULT_PORT)
    session = str(uuid.uuid4())
    wrapper_pid = os.getpid()
    wrapper_lstart = process_lstart(wrapper_pid)
    script = os.path.abspath(sys.argv[0])
    mutex = os.path.join(os.path.dirname(script), "qlb-proxy-mutex")
    env = os.environ.copy()
    env["QLB_WRAPPER_PID"] = str(wrapper_pid)
    env["QLB_WRAPPER_LSTART"] = wrapper_lstart
    env["QLB_SESSION"] = session
    env["QLB_HOME"] = home
    env["QLB_PROXY_PORT"] = str(port)
    env["QLB_PROXY_INFO_PATH"] = info_path
    child: Optional[subprocess.Popen[bytes]] = None
    # The handler only records; the main loop forwards to native while it is
    # alive and unreaped, so a signal can never reach a reused pid.
    received: list[int] = []
    forwarded = [0]
    shutting_down = [False]

    def handle(signum: int, _frame: Any) -> None:
        name = "INT" if signum == signal.SIGINT else "TERM" if signum == signal.SIGTERM else str(signum)
        print(f"SIGNAL={name}", flush=True)
        if not shutting_down[0]:
            record_terminating_signal(home, wrapper_pid, name)  # cleanup owns the lease after this
        received.append(signum)

    # Installed before the critical section so a signal during proxy setup is
    # recorded instead of killing the wrapper with a lease/proxy left behind.
    signal.signal(signal.SIGINT, handle)
    signal.signal(signal.SIGTERM, handle)

    def run_native() -> int:
        nonlocal child
        helper = os.path.join(os.path.dirname(script), "qlb-proxy-token")
        child_env = os.environ.copy()
        child_env["ANTHROPIC_BASE_URL"] = f"http://127.0.0.1:{port}"
        child_env["ANTHROPIC_CUSTOM_HEADERS"] = json.dumps({"x-qlb-session": session})
        child_env["CLAUDE_CODE_API_KEY_HELPER"] = helper
        child_env["QLB_HOME"] = home
        child_env["QLB_PROXY_INFO_PATH"] = info_path
        child_env.pop("ANTHROPIC_AUTH_TOKEN", None)
        child_env.pop("ANTHROPIC_API_KEY", None)
        child_env.pop("CLAUDE_CONFIG_DIR", None)
        native = native_claude()

        pause = os.environ.get("QLB_WRAPPER_PAUSE_BEFORE_LAUNCH")
        if pause:
            # Test seam: widen the pre-launch window deterministically.
            atomic_write(pause, "paused\n")
            while os.path.exists(pause) and not received:
                time.sleep(0.025)
        if received:
            return 128 + received[-1]  # interrupted before launch: never start native
        if os.environ.get("QLB_WRAPPER_SELF_SIGNAL_AT_SPAWN") == "1":
            # Test seam: a signal between the check above and the spawn below.
            os.kill(os.getpid(), signal.SIGTERM)
        try:
            child = subprocess.Popen([native, *argv], env=child_env)
        except OSError as err:
            sys.stderr.write(f"qlb wrapper: cannot launch {native}: {err.strerror or err}\n")
            if received:
                return 128 + received[-1]
            return 126 if isinstance(err, PermissionError) else 127
        while child.poll() is None:
            # Unreaped (even if it just exited), so child.pid cannot be reused yet.
            while forwarded[0] < len(received):
                try:
                    child.send_signal(received[forwarded[0]])
                except OSError:
                    pass
                forwarded[0] += 1
            time.sleep(0.05)
        rc = child.returncode
        return 128 + (-rc) if rc < 0 else rc

    cleanup_rc = 1
    try:
        try:
            result = subprocess.run(
                [mutex, lock, "--", sys.executable, script, "--qlb-critical-section"],
                env=env,
                check=False,
            )
        except OSError as err:
            sys.stderr.write(f"qlb wrapper: mutex failed: {err}\n")
            return 1
        if result.returncode == 0:
            code = run_native()
        elif received:
            code = 128 + received[-1]
        else:
            code = result.returncode if result.returncode > 0 else 1
    finally:
        # Always run once the critical section was attempted: releases this
        # wrapper's lease (and the proxy if last) on every exit path.
        shutting_down[0] = True
        shut_env = os.environ.copy()
        shut_env["QLB_WRAPPER_PID"] = str(wrapper_pid)
        shut_env["QLB_HOME"] = home
        shut_env["QLB_PROXY_INFO_PATH"] = info_path
        shut_env["QLB_PROXY_PORT"] = str(port)
        try:
            cleanup_rc = subprocess.run(
                [mutex, lock, "--", sys.executable, script, "--qlb-final-shutdown"],
                env=shut_env,
                check=False,
            ).returncode
        except OSError as err:
            sys.stderr.write(f"qlb wrapper: final mutex failed: {err}\n")
    if cleanup_rc != 0:
        sys.stderr.write("qlb wrapper: proxy cleanup failed; lease/proxy may remain\n")
        if code == 0:
            return 1
    if len(received) > forwarded[0] and code == 0:
        # A signal native never received (e.g. during final shutdown) still counts.
        return 128 + received[-1]
    return code


def main() -> int:
    argv = sys.argv[1:]
    if argv[:1] == ["--qlb-critical-section"]:
        return critical_section()
    if argv[:1] == ["--qlb-final-shutdown"]:
        return final_shutdown()
    first = argv[0] if argv else ""
    if first in PASSTHROUGH:
        return passthrough(argv)
    return intercepted(argv)


if __name__ == "__main__":
    sys.exit(main())
