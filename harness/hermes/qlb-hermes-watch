#!/bin/bash
# qlb-hermes-watch — run `qlb doctor` whenever the Hermes checkout HEAD changes (i.e. after
# `hermes update`), plus once a day. Writes a one-line verdict to ~/.qlb/hermes-watch.log and
# a machine-readable ~/.qlb/hermes-watch.json; on FAIL also posts a macOS notification.
#
# It never blocks or modifies Hermes. It tells you QLB needs attention *because* Hermes moved.
set -uo pipefail
HERMES_HOME="${HERMES_HOME:-$HOME/.hermes}"
CHECKOUT="$HERMES_HOME/hermes-agent"
STATE="$HOME/.qlb/hermes-watch.json"
LOG="$HOME/.qlb/hermes-watch.log"
QLB="${QLB_BIN:-$(command -v qlb || echo /opt/homebrew/bin/qlb)}"
mkdir -p "$HOME/.qlb"

head_sha() { git -C "$CHECKOUT" rev-parse HEAD 2>/dev/null || echo unknown; }
prev_sha=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('hermes_sha',''))" "$STATE" 2>/dev/null || true)
cur_sha=$(head_sha)
now=$(date +%s)
last_run=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('ran_at',0))" "$STATE" 2>/dev/null || echo 0)

# Run when HEAD moved, when forced, or at most once per 24h.
if [ "${1:-}" != "--force" ] && [ "$prev_sha" = "$cur_sha" ] && [ $((now - last_run)) -lt 86400 ]; then
  exit 0
fi

report=$("$QLB" doctor --live --json 2>/dev/null) || true
python3 - "$report" "$cur_sha" "$prev_sha" "$STATE" "$LOG" <<'EOF'
import json, sys, time, subprocess
report, cur, prev, state, log = sys.argv[1:6]
try:
    d = json.loads(report)
except Exception:
    d = {"checks": [], "overall": "FAIL"}
hermes = [c for c in d.get("checks", []) if c.get("name", "").startswith("hermes")]
bad = [c for c in hermes if c.get("level") != "PASS"]
level = "FAIL" if any(c["level"] == "FAIL" for c in bad) else ("WARN" if bad else "PASS")
moved = prev and prev != cur
line = f"{time.strftime('%Y-%m-%d %H:%M:%S')} {level} hermes={cur[:12]}{' (moved from '+prev[:12]+')' if moved else ''}"
if bad:
    line += " :: " + "; ".join(f"{c['name']}={c['level']}: {c['message'][:120]}" for c in bad)
with open(log, "a") as f:
    f.write(line + "\n")
json.dump({"hermes_sha": cur, "ran_at": int(time.time()), "level": level,
           "failing": [c["name"] for c in bad]}, open(state, "w"), indent=2)
if level == "FAIL":
    msg = ", ".join(c["name"] for c in bad)[:200]
    subprocess.run(["osascript", "-e",
        f'display notification "{msg}" with title "QLB: Hermes integration broke" subtitle "run: qlb doctor --live"'],
        check=False)
print(line)
EOF
